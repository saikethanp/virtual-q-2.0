# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API (Project URL & Anon / Public API Key)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Production App URL (Used for QR code generation and callback redirects)
# In production on Vercel, set this to your custom domain or vercel.app domain (e.g. https://virtual-q.vercel.app)
VITE_APP_URL=""
